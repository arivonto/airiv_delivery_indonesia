<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View Extension -->
        <record id="view_delivery_carrier_form_indonesia" model="ir.ui.view">
            <field name="name">delivery.carrier.form.indonesia</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Biteship Aggregator" name="biteship_settings" invisible="delivery_type != 'biteship'">
                        <group>
                            <group string="Biteship API Credentials">
                                <field name="biteship_api_key" password="True" required="delivery_type == 'biteship'"/>
                                <field name="biteship_environment"/>
                                <field name="biteship_origin_area_id" required="delivery_type == 'biteship'"/>
                            </group>
                            <group string="Courier Routing Rail">
                                <field name="biteship_courier_code" required="delivery_type == 'biteship'"/>
                                <field name="biteship_service_type"/>
                            </group>
                        </group>
                    </page>
                    <page string="RajaOngkir Engine" name="rajaongkir_settings" invisible="delivery_type != 'rajaongkir'">
                        <group>
                            <group string="RajaOngkir Settings">
                                <field name="rajaongkir_api_key" password="True" required="delivery_type == 'rajaongkir'"/>
                                <field name="rajaongkir_account_type"/>
                                <field name="rajaongkir_origin_id" required="delivery_type == 'rajaongkir'"/>
                            </group>
                            <group string="Courier Selection">
                                <field name="rajaongkir_courier" required="delivery_type == 'rajaongkir'"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <!-- Window Action: Indonesian Couriers -->
        <record id="action_delivery_carrier_indonesia" model="ir.actions.act_window">
            <field name="name">Indonesian Shipping Methods</field>
            <field name="res_model">delivery.carrier</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('delivery_type', 'in', ['biteship', 'rajaongkir'])]</field>
            <field name="context">{'default_delivery_type': 'biteship'}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Configure your first Indonesian Courier (Biteship / RajaOngkir)
                </p>
            </field>
        </record>

        <!-- Window Action: Indonesian Outgoing Deliveries & Resi -->
        <record id="action_stock_picking_indonesia" model="ir.actions.act_window">
            <field name="name">Waybills &amp; Deliveries (Resi)</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="domain">[('picking_type_code', '=', 'outgoing')]</field>
            <field name="context">{'default_picking_type_code': 'outgoing'}</field>
        </record>

        <!-- Root App Drawer Menu -->
        <menuitem id="menu_airiv_delivery_root"
                  name="Indonesian Logistics"
                  action="action_delivery_carrier_indonesia"
                  web_icon="airiv_delivery_indonesia,static/description/icon.png"
                  sequence="35"
                  groups="base.group_user"/>

        <!-- Operations Category -->
        <menuitem id="menu_airiv_delivery_operations"
                  name="Operations"
                  parent="menu_airiv_delivery_root"
                  sequence="10"/>

        <menuitem id="menu_airiv_delivery_carriers"
                  name="Courier Services"
                  parent="menu_airiv_delivery_operations"
                  action="action_delivery_carrier_indonesia"
                  sequence="1"/>

        <menuitem id="menu_airiv_delivery_pickings"
                  name="Waybills &amp; Shipments (Resi)"
                  parent="menu_airiv_delivery_operations"
                  action="action_stock_picking_indonesia"
                  sequence="2"/>
    </data>
</odoo>
